{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "typecheck": "nuxt prepare && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "nuxt build",
    "dev": "cross-env NODE_OPTIONS=--use-system-ca nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "analyze": "nuxt analyze",
    "eslint": "eslint . --max-warnings 0",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{css,vue}\" --max-warnings 0",
    "stylelint:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "build:debug": "npm run build && NODE_OPTIONS=--max-old-space-size=64 node --expose-gc --inspect .output/server/index.mjs",
    "start": "node .output/server/index.mjs"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@nuxt/eslint": "~1.17.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "crossws": "^0.4.17",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "nuxt": "^4.6.3",
    "postcss-custom-media": "^12.0.1",
    "postcss-html": "^2.0.0",
    "postcss-import": "^17.0.1",
    "postcss-inline-media": "^1.5.0",
    "postcss-nested": "^9.0.1",
    "postcss-preset-env": "^11.3.0",
    "postcss-reporter": "^7.1.0",
    "prettier": "3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plugin-compression": "^0.5.1",
    "vue-eslint-parser": "^10.4.1",
    "deepmerge": "file:vendor/deepmerge"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "@popperjs/core": "^2.11.8",
    "@vee-validate/i18n": "^4.7.3",
    "@vee-validate/rules": "^4.7.3",
    "@vue/devtools-api": "^8.2.1",
    "@vuepic/vue-datepicker": "^14.0.0",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "nuxt-icons": "^4.0.0",
    "pinia": "^4.1.0",
    "swiper": "^14.3.0",
    "uuid": "^14.0.0",
    "vee-validate": "^4.7.3"
  },
  "overrides": {
    "vue": "^3.5.44",
    "deepmerge": "$deepmerge"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.27.2": true,
    "fsevents": false
  }
}
